# Copy to .env. Used by docker-compose and local dev.
# Only SESSION_SECRET and COLLAB_SECRET are required; everything else has a default
# or turns its feature off when empty.

# Public origin people open in the browser (share links, secure cookies, CSRF check,
# OAuth issuer of the MCP server). No trailing slash.
BEE_PUBLIC_URL=http://localhost:7070
# Host port of the Caddy proxy.
BEE_PORT=7070

POSTGRES_USER=bee
POSTGRES_PASSWORD=bee
POSTGRES_DB=bee
# Local dev (outside docker) connects via the published dev port.
DATABASE_URL=postgres://bee:bee@localhost:54329/bee

# Long random strings, e.g. `openssl rand -hex 32`. Change both in production.
# SESSION_SECRET signs session cookies; COLLAB_SECRET is shared by apps/collab and
# apps/api for the /internal endpoints.
SESSION_SECRET=change-me-to-a-long-random-string
COLLAB_SECRET=change-me-collab-secret
# Encrypts users' AI provider keys at rest. Defaults to one derived from SESSION_SECRET;
# set it if you want to rotate SESSION_SECRET without losing saved AI keys.
AI_KEYS_SECRET=

# Comma-separated extra origins allowed to make cookie-authenticated requests.
ALLOWED_ORIGINS=http://localhost:7070
# Set to false to close sign-ups.
ALLOW_REGISTRATION=true
# Per-file upload limit.
MAX_UPLOAD_MB=25
# Per-minute limits: sign-in attempts per IP, Ask AI requests per user, guest comments per IP.
AUTH_RATE_LIMIT=20
AI_RATE_LIMIT=20
GUEST_COMMENT_RATE_LIMIT=5
# Guest comments per share link per hour.
GUEST_COMMENT_HOURLY_LIMIT=60

# Email notifications (off when empty), e.g. smtps://user:app-password@smtp.example.com:465
SMTP_URL=
MAIL_FROM=Bee <notifications@example.com>
# Where "Report a problem" submissions are emailed (needs SMTP_URL). Reports are always
# stored in the database; without this they are not emailed.
BUG_REPORT_TO=
# Browser (Web Push) notifications (off when empty): npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# "Continue with Google" (off when empty). Google Cloud Console → Credentials → OAuth client ID
# (Web application), redirect URI: <BEE_PUBLIC_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
