# Copy to .env. Used by docker-compose and local dev.
BEE_PUBLIC_URL=http://localhost:7070
POSTGRES_USER=bee
POSTGRES_PASSWORD=bee
POSTGRES_DB=bee
# Local dev (outside docker) connects via the published dev port.
DATABASE_URL=postgres://bee:bee@localhost:54329/bee
# Long random string; signs session cookies. Change in production.
SESSION_SECRET=change-me-to-a-long-random-string
# Shared secret between apps/collab and apps/api for /internal endpoints.
COLLAB_SECRET=change-me-collab-secret
# Optional
REDIS_URL=
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Email notifications (off when empty), e.g. smtps://user:app-password@smtp.gmail.com:465
SMTP_URL=
MAIL_FROM=Bee <notifications@example.com>
# Browser (Web Push) notifications (off when empty): npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
