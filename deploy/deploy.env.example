# Copy to deploy/deploy.env (not committed) for deploy/sync.sh.
# SSH host of the server; `ssh <host>` must work without a password prompt.
BEE_DEPLOY_HOST=my-server
# Public origin of the deployment; becomes BEE_PUBLIC_URL in the server's .env on first deploy.
BEE_DEPLOY_URL=https://docs.example.com
# Remote checkout, relative to the ssh user's home.
BEE_DEPLOY_DIR=Documents/bee
