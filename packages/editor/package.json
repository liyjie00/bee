{
  "name": "@bee/editor",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "sideEffects": ["*.css"],
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./markdown": { "types": "./dist/markdown/index.d.ts", "default": "./dist/markdown/index.js" },
    "./schema": { "types": "./dist/schema/index.d.ts", "default": "./dist/schema/index.js" },
    "./styles.css": "./src/styles.css"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "0.18.1",
    "@hocuspocus/provider": "4.8.0",
    "@tiptap/core": "3.32.2",
    "@tiptap/extension-code-block-lowlight": "3.32.2",
    "@tiptap/extension-collaboration": "3.32.2",
    "@tiptap/extension-collaboration-caret": "3.32.2",
    "@tiptap/extension-image": "3.32.2",
    "@tiptap/extension-list": "3.32.2",
    "@tiptap/extension-table": "3.32.2",
    "@tiptap/extension-unique-id": "3.32.2",
    "@tiptap/extensions": "3.32.2",
    "@tiptap/pm": "3.32.2",
    "@tiptap/react": "3.32.2",
    "@tiptap/starter-kit": "3.32.2",
    "@tiptap/suggestion": "3.32.2",
    "@tiptap/y-tiptap": "^3.0.12",
    "lowlight": "^3.3.0",
    "marked": "^18.1.2",
    "mermaid": "^12.2.0",
    "nanoid": "^5.1.6",
    "yjs": "^13.6.33"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "jsdom": "^26.1.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  }
}
